{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lines",
  "version": "0.1.0",
  "identifier": "com.vladartym.lines",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lines",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "iOS": {
      "developmentTeam": "C5338FSGXJ",
      "minimumSystemVersion": "17.0"
    }
  }
}
