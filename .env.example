# The address of your Lines server (server/ in this repository), and its API key (LINES_API_KEY in server/.env).
# The key goes into the app when it builds, so never share your build.
VITE_SERVER_URL=https://phone.example.com
VITE_SERVER_KEY=

# The iPhone for bun run install-ios (xcrun devicectl list devices), and the simulator for bun run sim.
# IPHONE=
# SIM=

# Signing with push for the iPhone build (scripts/xcodebuild): an App Store Connect API key with its .p8 file.
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH=

# The Mac app signs with this identity (bun run install-app), so macOS keeps its Contacts and Microphone answers
# across rebuilds. Without it the build is ad hoc, and each rebuild asks again. See: security find-identity -v -p codesigning
# MAC_SIGNING_IDENTITY=
