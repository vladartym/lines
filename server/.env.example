# The public name of the server. Point its DNS A record at the server first: Caddy gets the certificate for it.
SERVER_HOST=phone.example.com

# Make each secret with: openssl rand -hex 32
DJANGO_SECRET_KEY=
# The key of the app. Put the same value in VITE_SERVER_KEY in the .env of the app.
LINES_API_KEY=
# The secret in the URLs of the text hook (VoIP.ms) and the ring hook (Asterisk). Letters and digits only.
PHONE_HOOK_TOKEN=
# The SIP password of the app. The app gets it from the API, so you never type it.
PHONE_SIP_PASSWORD=

# The VoIP.ms API: the email of your account, and the API password of the API page. Put the IP address of this
# server on that page too.
VOIPMS_USERNAME=
VOIPMS_API_PASSWORD=
# The voicemail box that your numbers send an unanswered call to, such as 1001.
VOIPMS_MAILBOX=

# The VoIP.ms sub-account that your numbers route their calls to, such as 123456_lines, and its password.
VOIPMS_SIP_USERNAME=
VOIPMS_SIP_PASSWORD=
# The VoIP.ms server that the sub-account registers to. Take the one nearest to this server.
VOIPMS_SERVER=toronto1.voip.ms
# Optional: the addresses that VoIP.ms sends calls from, such as 208.100.60.0/24. With no value, the address of
# VOIPMS_SERVER. Use a range if a call that comes in gets no answer from Asterisk.
VOIPMS_MATCH=

# Optional: the push of texts and calls to the iPhone app, with an APNs auth key of your Apple team.
# APNS_KEY is the .p8 file in base64: base64 -i AuthKey_XXXXXXXXXX.p8
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# The bundle ID of your build of the app (identifier in src-tauri/tauri.conf.json).
APNS_TOPIC=
